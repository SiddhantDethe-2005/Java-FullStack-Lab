public class SearchAndSortFixed {
    public static void main(String[] args) {

        int[] arr = {91, 7, 6, 1, 100, 108};
        int n = arr.length;

        System.out.println("Original Array:");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }

        // -------- Bubble Sort --------
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    // Swap
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }

        System.out.println("\nSorted Array (Bubble Sort):");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }

        // -------- Linear Search --------
        int key = 91; // You can change this value

        boolean found = false;

        for (int i = 0; i < n; i++) {
            if (arr[i] == key) {
                System.out.println("\nElement " + key + " found at position: " + (i + 1));
                found = true;
                break;
            }
        }

        if (!found) {
            System.out.println("\nElement " + key + " not found");
        }
    }
}
